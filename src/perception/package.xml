<?xml version="1.0"?>
<package format="2">
  <name>perception</name>
  <version>0.1.0</version>
  <description>Depth-to-pointcloud and Octomap perception utilities for Unity ROS.</description>

  <maintainer email="maintainer@example.com">Autonomous Driving Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>depth_image_proc</depend>
  <depend>image_transport</depend>
  <depend>nodelet</depend>
  <depend>octomap_msgs</depend>
  <depend>octomap_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
</package>
